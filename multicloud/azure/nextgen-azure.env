# Edit once, then run:  source nextgen-azure.env
export SUB_ID="00000000-0000-0000-0000-000000000000"
export LOCATION="eastus2"
export PREFIX="nextgen"
export ENV="dev"
export SUFFIX="7k2q"                  # 4 lowercase letters/digits, unique to you
export DOMAIN="nextgen.example.com"   # a DNS domain you control
export MY_IP="$(curl -s https://ifconfig.me)"

export RG="rg-$PREFIX-$ENV"
export LAW="law-$PREFIX-$ENV"
export VNET="vnet-$PREFIX-$ENV"
export AKS="aks-$PREFIX-$ENV"
export APPGW="agw-$PREFIX-$ENV"
# Globally unique names (DNS-visible)
export KV="kv-$PREFIX-$ENV-$SUFFIX"         # 3-24 chars
export SA="st$PREFIX$ENV$SUFFIX"            # 3-24 lowercase letters/digits
export FILES_SA="stfs$PREFIX$ENV$SUFFIX"
export FUNC_SA="stfn$PREFIX$ENV$SUFFIX"
export FUNC_APP="func-$PREFIX-$ENV-$SUFFIX"
export COSMOS="cosmos-$PREFIX-$ENV-$SUFFIX"
export PG="psql-$PREFIX-$ENV-$SUFFIX"
export SQLSRV="sql-$PREFIX-$ENV-$SUFFIX"
