# Edit once, then run:  source settings.env
export PROJECT_ID="shopnow-dev-7k2q"            # globally unique, 6-30 chars
export BILLING_ACCOUNT="000000-000000-000000"
export ORG_DOMAIN="example.com"                 # Cloud Identity / Workspace domain
export REGION="us-central1"
export ZONE="us-central1-a"
export PREFIX="shopnow"
export ENV="dev"
export DOMAIN="shopnow.example.com"
export MY_IP="$(curl -s https://ifconfig.me)"

export NETWORK="vpc-$PREFIX-$ENV"
export GKE="gke-$PREFIX-$ENV"
export BUCKET="$PROJECT_ID-artifacts"
export SA_VM="sa-$PREFIX-vm@$PROJECT_ID.iam.gserviceaccount.com"
export SA_GKE="sa-$PREFIX-gke@$PROJECT_ID.iam.gserviceaccount.com"
export SA_FN="sa-$PREFIX-fn@$PROJECT_ID.iam.gserviceaccount.com"
export SA_APP="sa-$PREFIX-app@$PROJECT_ID.iam.gserviceaccount.com"
