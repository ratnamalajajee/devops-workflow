# Sign in first, then run:  source settings.env
export AWS_PROFILE="shopnow-dev"
export AWS_REGION="us-east-1"
export AWS_PAGER=""                   # print output instead of opening a pager
export PREFIX="shopnow"
export ENV="dev"
export SUFFIX="7k2q"                  # 4 lowercase letters/digits, unique to you
export DOMAIN="shopnow.example.com"
export MY_IP="$(curl -s https://ifconfig.me)"
export AZ1="${AWS_REGION}a"
export AZ2="${AWS_REGION}b"
export EKS="eks-$PREFIX-$ENV"
export BUCKET="$PREFIX-$ENV-$SUFFIX-artifacts"
export ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"

# AWS IDs are generated, so later steps look them up by name
vpc_id()    { aws ec2 describe-vpcs --filters "Name=tag:Name,Values=vpc-$PREFIX-$ENV" --query 'Vpcs[0].VpcId' --output text; }
subnet_id() { aws ec2 describe-subnets --filters "Name=tag:Name,Values=$1" --query 'Subnets[0].SubnetId' --output text; }
sg_id()     { aws ec2 describe-security-groups --filters "Name=group-name,Values=$1" --query 'SecurityGroups[0].GroupId' --output text; }
vm_id()     { aws ec2 describe-instances --filters "Name=tag:Name,Values=vm-$PREFIX-01" "Name=instance-state-name,Values=running" --query 'Reservations[0].Instances[0].InstanceId' --output text; }
